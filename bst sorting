#include <iostream>
using namespace std;

int comparisons = 0;

// BST Node
struct Node {
    int data;
    Node* left;
    Node* right;
};

// Create new node
Node* createNode(int value) {
    Node* newNode = new Node();
    newNode->data = value;
    newNode->left = newNode->right = NULL;
    return newNode;
}

// Insert into BST (with comparison count)
Node* insert(Node* root, int value) {
    if (root == NULL)
        return createNode(value);

    comparisons++; // comparison

    if (value < root->data)
        root->left = insert(root->left, value);
    else {
        comparisons++; // second comparison (value >= root->data)
        root->right = insert(root->right, value);
    }

    return root;
}

// Inorder traversal (sorted output)
void inorder(Node* root) {
    if (root != NULL) {
        inorder(root->left);
        cout << root->data << " ";
        inorder(root->right);
    }
}

int main() {
    Node* root = NULL;
    int arr[10];

    cout << "Enter 10 numbers:\n";
    for (int i = 0; i < 10; i++) {
        cin >> arr[i];
        root = insert(root, arr[i]);
    }

    cout << "\nSorted array (BST Sort):\n";
    inorder(root);

    cout << "\n\nNumber of comparisons: " << comparisons << endl;

    return 0;
}
