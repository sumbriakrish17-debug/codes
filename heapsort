#include <iostream>
using namespace std;

int comparisons = 0;

// Heapify function
void heapify(int arr[], int n, int i) {
    int largest = i;
    int left = 2 * i + 1;
    int right = 2 * i + 2;

    // Compare left child
    if (left < n) {
        comparisons++;
        if (arr[left] > arr[largest])
            largest = left;
    }

    // Compare right child
    if (right < n) {
        comparisons++;
        if (arr[right] > arr[largest])
            largest = right;
    }

    // Swap if needed
    if (largest != i) {
        swap(arr[i], arr[largest]);
        heapify(arr, n, largest);
    }
}

// Heap Sort
void heapSort(int arr[], int n) {

    // Build max heap
    for (int i = n / 2 - 1; i >= 0; i--)
        heapify(arr, n, i);

    // Extract elements
    for (int i = n - 1; i > 0; i--) {
        swap(arr[0], arr[i]);   // Move max to end
        heapify(arr, i, 0);     // Heapify reduced heap
    }
}

int main() {
    int arr[10];

    cout << "Enter 10 numbers:\n";
    for (int i = 0; i < 10; i++) {
        cin >> arr[i];
    }

    heapSort(arr, 10);

    cout << "\nSorted array:\n";
    for (int i = 0; i < 10; i++) {
        cout << arr[i] << " ";
    }

    cout << "\n\nNumber of comparisons: " << comparisons << endl;

    return 0;
}
