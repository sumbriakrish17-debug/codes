#include <stdio.h>
#include <stdlib.h>

struct node
{
    int data;
    struct node *left;
    struct node *right;
};

struct node* createNode(int data)
{
    struct node* newNode = (struct node*)malloc(sizeof(struct node));
    newNode->data = data;
    newNode->left = NULL;
    newNode->right = NULL;
    return newNode;
}

int height(struct node* root)
{
    if(root == NULL)
        return -1;

    int lh = height(root->left);
    int rh = height(root->right);

    return (lh > rh ? lh : rh) + 1;
}

int balanceFactor(struct node* root)
{
    if(root == NULL)
        return 0;

    return height(root->left) - height(root->right);
}

struct node* insert(struct node* root, int data)
{
    if(root == NULL)
        return createNode(data);

    if(data < root->data)
        root->left = insert(root->left, data);
    else
        root->right = insert(root->right, data);

    return root;
}

void displayBalance(struct node* root)
{
    if(root == NULL)
        return;

    displayBalance(root->left);

    printf("Node %d -> Balance Factor = %d\n", root->data, balanceFactor(root));

    displayBalance(root->right);
}

/* LL Rotation */
struct node* LLRotation(struct node* root)
{
    struct node* temp = root->left;
    root->left = temp->right;
    temp->right = root;

    return temp;
}

/* RR Rotation */
struct node* RRRotation(struct node* root)
{
    struct node* temp = root->right;
    root->right = temp->left;
    temp->left = root;

    return temp;
}

/* LR Rotation */
struct node* LRRotation(struct node* root)
{
    root->left = RRRotation(root->left);
    return LLRotation(root);
}

/* RL Rotation */
struct node* RLRotation(struct node* root)
{
    root->right = LLRotation(root->right);
    return RRRotation(root);
}

void inorder(struct node* root)
{
    if(root == NULL)
        return;

    inorder(root->left);
    printf("%d ", root->data);
    inorder(root->right);
}

int main()
{
    struct node* root = NULL;

    int arr[] = {8,6,4,3,7,5,10,11,9};
    int n = 9;

    for(int i=0;i<n;i++)
        root = insert(root, arr[i]);

    int choice;

    while(1)
    {
        printf("\n------ AVL Tree Menu ------\n");
        printf("1. Display Inorder Traversal\n");
        printf("2. Show Balance Factors\n");
        printf("3. Insert 2\n");
        printf("4. LL Rotation\n");
        printf("5. RR Rotation\n");
        printf("6. LR Rotation\n");
        printf("7. RL Rotation\n");
        printf("8. Exit\n");

        printf("Enter choice: ");
        scanf("%d",&choice);

        switch(choice)
        {
            case 1:
                printf("Inorder: ");
                inorder(root);
                printf("\n");
                break;

            case 2:
                printf("\nBalance Factors:\n");
                displayBalance(root);
                break;

            case 3:
                root = insert(root,2);
                printf("2 inserted.\n");
                break;

            case 4:
                root = LLRotation(root);
                printf("LL Rotation Done\n");
                break;

            case 5:
                root = RRRotation(root);
                printf("RR Rotation Done\n");
                break;

            case 6:
                root = LRRotation(root);
                printf("LR Rotation Done\n");
                break;

            case 7:
                root = RLRotation(root);
                printf("RL Rotation Done\n");
                break;

            case 8:
                exit(0);

            default:
                printf("Invalid Choice\n");
        }
    }

    return 0;
}
