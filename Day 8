    #include <stdio.h>
#include <limits.h>

#define V 4

#define WHITE 0
#define GRAY 1
#define BLACK 2

int time = 0;
int call = 1;

void printColor(int color[]) {
    printf("Color Array:\n");
    for (int i = 0; i < V; i++) printf("%d ", i);
    printf("\n");

    for (int i = 0; i < V; i++) {
        if (color[i] == WHITE) printf("White ");
        else if (color[i] == GRAY) printf("Grey ");
        else printf("Black ");
    }
    printf("\n\n");
}

void printStartTime(int d[]) {
    printf("Starting Time Array:\n");
    for (int i = 0; i < V; i++) printf("%d ", i);
    printf("\n");

    for (int i = 0; i < V; i++) {
        if (d[i] == INT_MAX) printf("0 ");
        else printf("%d ", d[i]);
    }
    printf("\n\n");
}

void printFinishTime(int f[]) {
    printf("Finishing Time Array:\n");
    for (int i = 0; i < V; i++) printf("%d ", i);
    printf("\n");

    for (int i = 0; i < V; i++) {
        if (f[i] == INT_MAX) printf("0 ");
        else printf("%d ", f[i]);
    }
    printf("\n\n");
}

void printParent(int parent[]) {
    printf("Pi Array:\n");
    for (int i = 0; i < V; i++) {
        printf("Node %d -> Parent: %d\n", i, parent[i]);
    }
    printf("\n");
}

void DFS_Visit(int graph[V][V], int u, int color[], int parent[], int d[], int f[]) {

    printf("--------------------------------------------------\n");
    printf("Recursive call %d        Visited %d\n\n", call++, u);

    color[u] = GRAY;
    d[u] = ++time;

    printColor(color);
    printStartTime(d);

    for (int v = 0; v < V; v++) {
        if (graph[u][v] == 1 && color[v] == WHITE) {
            parent[v] = u;
            DFS_Visit(graph, v, color, parent, d, f);
        }
    }

    color[u] = BLACK;
    f[u] = ++time;

    printf("--------------------------------------------------\n");
    printf("Finishing Node %d\n\n", u);

    printColor(color);
    printFinishTime(f);
    printParent(parent);
}

void DFS(int graph[V][V]) {
    int color[V], parent[V], d[V], f[V];

    for (int i = 0; i < V; i++) {
        color[i] = WHITE;
        parent[i] = -1;
        d[i] = INT_MAX;
        f[i] = INT_MAX;
    }

    for (int i = 0; i < V; i++) {
        if (color[i] == WHITE) {
            DFS_Visit(graph, i, color, parent, d, f);
        }
    }
}

int main() {

    int graph[V][V] = {
        //0 1 2 3
        {0,1,1,0}, // 0 → 1,2
        {0,0,0,1}, // 1 → 3
        {0,1,0,0}, // 2 → 1
        {0,0,1,0}  // 3 → 2
    };

    DFS(graph);

    return 0;
}
