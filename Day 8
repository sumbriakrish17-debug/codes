#include <stdio.h>
#include <limits.h>

#define V 4

#define WHITE 0
#define GRAY 1
#define BLACK 2

int time = 0;

// Stack for display
int stack[V];
int top = -1;

void push(int x) {
    stack[++top] = x;
}

void pop() {
    if (top >= 0) top--;
}

void printStack() {
    printf("Stack: ");
    for (int i = 0; i <= top; i++)
        printf("%d ", stack[i]);
    printf("\n");
}

void printColor(int color[]) {
    printf("Color: ");
    for (int i = 0; i < V; i++) {
        if (color[i] == WHITE) printf("W ");
        else if (color[i] == GRAY) printf("G ");
        else printf("B ");
    }
    printf("\n");
}

void DFS_Visit(int graph[V][V], int u, int color[], int parent[], int d[], int f[]) {

    color[u] = GRAY;
    d[u] = ++time;

    push(u);

    printf("\nVisit Node: %d\n", u);
    printStack();
    printColor(color);
    printf("Start Time: %d\n", d[u]);

    for (int v = 0; v < V; v++) {
        if (graph[u][v] == 1 && color[v] == WHITE) {
            parent[v] = u;
            DFS_Visit(graph, v, color, parent, d, f);
        }
    }

    color[u] = BLACK;
    f[u] = ++time;

    pop();

    printf("Finish Node: %d\n", u);
    printStack();
    printColor(color);
    printf("Finish Time: %d\n", f[u]);
}

void DFS(int graph[V][V]) {
    int color[V], parent[V], d[V], f[V];

    for (int i = 0; i < V; i++) {
        color[i] = WHITE;
        parent[i] = -1;
        d[i] = INT_MAX;
        f[i] = INT_MAX;
    }

    for (int i = 0; i < V; i++) {
        if (color[i] == WHITE) {
            DFS_Visit(graph, i, color, parent, d, f);
        }
    }

    // Parent array
    printf("\nParent (π) array:\n");
    for (int i = 0; i < V; i++) {
        printf("%d -> %d\n", i, parent[i]);
    }

    // Parenthesis structure
    printf("\nParenthesis structure:\n");
    for (int i = 0; i < V; i++) {
        printf("%d: (%d, %d)\n", i, d[i], f[i]);
    }
}

int main() {

    int graph[V][V] = {
        //0 1 2 3
        {0,1,1,0}, // 0 → 1,2
        {0,0,0,1}, // 1 → 3
        {0,1,0,0}, // 2 → 1
        {0,0,1,0}  // 3 → 2
    };

    DFS(graph);

    return 0;
}
