#include <stdio.h>

// Function to swap elements (for sorting)
void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

// Simple Bubble Sort (to sort input first)
void sort(int arr[], int n) {
    for (int i = 0; i < n-1; i++) {
        for (int j = 0; j < n-i-1; j++) {
            if (arr[j] > arr[j+1]) {
                swap(&arr[j], &arr[j+1]);
            }
        }
    }
}

// Binary Search with comparison count
int binarySearch(int arr[], int n, int key, int *comparisons) {
    int left = 0, right = n - 1;
    *comparisons = 0;

    while (left <= right) {
        int mid = (left + right) / 2;

        (*comparisons)++;  // comparison with mid

        if (arr[mid] == key)
            return mid;

        (*comparisons)++;  // comparison for direction

        if (key < arr[mid])
            right = mid - 1;
        else
            left = mid + 1;
    }

    return -1;  // not found
}

int main() {
    int arr[10];

    printf("Enter 10 numbers:\n");
    for (int i = 0; i < 10; i++) {
        scanf("%d", &arr[i]);
    }

    // Sort array before binary search
    sort(arr, 10);

    printf("\nSorted array:\n");
    for (int i = 0; i < 10; i++) {
        printf("%d ", arr[i]);
    }

    int key1, key2;
    int comp1, comp2;

    // Existing element
    printf("\n\nEnter a number to search (existing): ");
    scanf("%d", &key1);

    int result1 = binarySearch(arr, 10, key1, &comp1);

    if (result1 != -1)
        printf("Element found at position %d\n", result1 + 1);
    else
        printf("Element not found\n");

    printf("Comparisons made: %d\n", comp1);

    // Non-existing element
    printf("\nEnter a number to search (non-existing): ");
    scanf("%d", &key2);

    int result2 = binarySearch(arr, 10, key2, &comp2);

    if (result2 != -1)
        printf("Element found at position %d\n", result2 + 1);
    else
        printf("Element not found\n");

    printf("Comparisons made: %d\n", comp2);

    return 0;
}
