#include <stdio.h>
#include <time.h>

int main()
{
    int n, i, j, temp;
    int comparisons = 0;
    int arr[100];

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    clock_t start, end;

    start = clock();

    // Bubble Sort
    for(i = 0; i < n - 1; i++)
    {
        for(j = 0; j < n - i - 1; j++)
        {
            comparisons++;

            if(arr[j] > arr[j + 1])
            {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    end = clock();

    printf("\nSorted array in ascending order:\n");

    for(i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    double time_taken = ((double)(end - start)) / CLOCKS_PER_SEC;

    printf("\n\nNumber of comparisons: %d", comparisons);
    printf("\nTime taken: %f seconds\n", time_taken);

    return 0;
}
