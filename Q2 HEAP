#include <stdio.h>

int h[100], n = 0;

void swap(int *a, int *b) {
    int t = *a;
    *a = *b;
    *b = t;
}

void heapify(int i) {
    int l = 2 * i + 1;
    int r = 2 * i + 2;
    int m = i;

    if (l < n && h[l] > h[m])
        m = l;

    if (r < n && h[r] > h[m])
        m = r;

    if (m != i) {
        swap(&h[i], &h[m]);
        heapify(m);
    }
}

void enqueue(int v) {
    h[n] = v;
    int i = n;
    n++;

    while (i > 0 && h[(i - 1) / 2] < h[i]) {
        swap(&h[i], &h[(i - 1) / 2]);
        i = (i - 1) / 2;
    }

    printf("Enqueued %d\n", v);
}

int dequeue() {
    if (n == 0) {
        printf("Priority Queue is empty!\n");
        return -1;
    }

    int v = h[0];
    h[0] = h[n - 1];
    n--;

    heapify(0);
    return v;
}

int peek() {
    if (n == 0) {
        printf("Priority Queue is empty!\n");
        return -1;
    }

    return h[0];
}

void display() {
    if (n == 0) {
        printf("Priority Queue is empty!\n");
        return;
    }

    printf("Priority Queue: ");
    for (int i = 0; i < n; i++)
        printf("%d ", h[i]);

    printf("\n");
}

int main() {
    int c, v;

    printf("===== Max Priority Queue =====\n");
    printf("1. Enqueue\n2. Dequeue\n3. Peek\n4. Display\n0. Exit\n");

    while (1) {
        printf("\nEnter choice: ");
        scanf("%d", &c);

        switch (c) {

        case 1:
            printf("Enter value: ");
            scanf("%d", &v);
            enqueue(v);
            display();
            break;

        case 2:
            v = dequeue();
            if (v != -1)
                printf("Dequeued: %d\n", v);
            display();
            break;

        case 3:
            v = peek();
            if (v != -1)
                printf("Highest priority element: %d\n", v);
            break;

        case 4:
            display();
            break;

        case 0:
            printf("Exiting.\n");
            return 0;

        default:
            printf("Invalid choice!\n");
        }
    }

    return 0;
}
